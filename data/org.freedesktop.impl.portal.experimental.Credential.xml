<node name="/" xmlns:doc="http://www.freedesktop.org/dbus/1.0/doc.dtd">
  <!--
      org.freedesktop.impl.portal.experimental.Credential:
      @short_description: Credential portal backend interface

      The Credential portal allows sandboxed applications to retrieve
      application-scoped web credentials. This backend interface presents the
      user interface for an interactive credential ceremony, such as creating
      or using a WebAuthn passkey.

      Each ceremony is represented by a session. The caller creates it with
      :ref:`org.freedesktop.impl.portal.experimental.Credential.CreateSession`,
      then informs the backend about changes in the ceremony with the
      ``Notify`` methods. The backend reports user interaction back to the
      caller with the signals on this interface.

      The backend MUST send all signals on this interface, and the ``Closed``
      signal of the session, as unicast signals to the caller that created the
      session. Some signals carry secrets, and callers only listen for signals
      addressed to them.

      The backend MUST reject ``Notify`` calls for a session from any peer
      other than the one that created it.

      🧪 This documentation describes an experimental version of this
      interface.

      This documentation describes version 1 of this interface.
  -->
  <interface name="org.freedesktop.impl.portal.experimental.Credential">

    <!--
        CreateSession:
        @session_handle: Object path for the :ref:`org.freedesktop.impl.portal.Session` object representing the ceremony
        @parent_window: Identifier for the application window, see :doc:`window-identifiers`
        @origin: The origin of the request
        @type: Type of the credential request
        @devices: Initial list of credential sources, as pairs of source ID and transport
        @app_id: App ID of the application
        @app_pid: PID of the application
        @options: Vardict with optional further information

        Starts a credential ceremony and presents the dialog for it.

        The backend exports an :ref:`org.freedesktop.impl.portal.Session`
        object at @session_handle. The caller can close the session with
        :ref:`org.freedesktop.impl.portal.Session.Close` to end the ceremony.
        When the user dismisses the dialog before the ceremony completes, the
        backend emits :ref:`org.freedesktop.impl.portal.Session::Closed` and
        removes the session. The backend does not emit ``Closed`` when the
        caller closes the session, or after
        :ref:`org.freedesktop.impl.portal.experimental.Credential.NotifyCeremonyCompleted`.
        The backend also removes the session if the caller disconnects from
        the bus.

        Callers should subscribe to the signals on this interface before
        calling this method.

        @parent_window may be an empty string if there is no parent window.

        Supported values for @type:

        * ``0``: PublicKeyCreate. Create a WebAuthn public key credential.
        * ``1``: PublicKeyGet. Use a WebAuthn public key credential.

        Supported transports in @devices are ``Ble``, ``HybridLinked``,
        ``HybridQr``, ``Internal``, ``Nfc`` and ``Usb``.

        Supported keys in the @options vardict include:

        * ``activation_token`` (``s``)

          A token that can be used to activate the dialog.

        * ``top_origin`` (``s``)

          Top-level origin of the request, if different from @origin.

        * ``rp_id`` (``s``)

          WebAuthn relying party ID. Required if @type is PublicKeyCreate or
          PublicKeyGet.

        Once the dialog is ready, the backend emits
        :ref:`org.freedesktop.impl.portal.experimental.Credential::DiscoveryRequested`.
    -->
    <method name="CreateSession">
      <arg type="o" name="session_handle" direction="in"/>
      <arg type="s" name="parent_window" direction="in"/>
      <arg type="s" name="origin" direction="in"/>
      <arg type="u" name="type" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In4" value="QList&lt;std::tuple&lt;QString,QString&gt;&gt;"/>
      <arg type="a(ss)" name="devices" direction="in"/>
      <arg type="s" name="app_id" direction="in"/>
      <arg type="u" name="app_pid" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In7" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
    </method>

    <!--
        NotifyNeedsPin:
        @session_handle: Object path of the session
        @attempts_left: Number of PIN attempts left, or ``0xffffffff`` if unknown
        @options: Vardict with optional further information

        The authenticator needs PIN user verification. The backend should
        prompt the user for the PIN, and send it with
        :ref:`org.freedesktop.impl.portal.experimental.Credential::ClientPinEntered`.

        The backend should warn the user that the authenticator will lock
        itself, and its credentials may be permanently lost, once
        @attempts_left reaches zero.

        There are no supported keys in the @options vardict.
    -->
    <method name="NotifyNeedsPin">
      <arg type="o" name="session_handle" direction="in"/>
      <arg type="u" name="attempts_left" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In2" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
    </method>

    <!--
        NotifyPinNotSet:
        @session_handle: Object path of the session
        @error: Reason a new PIN is needed
        @options: Vardict with optional further information

        The authenticator needs a PIN, but none is set, or the previous
        attempt to set one was rejected. The backend should prompt the user
        for a new PIN, and send it with
        :ref:`org.freedesktop.impl.portal.experimental.Credential::SetDevicePin`.

        Supported values for @error:

        * ``PinNotSet``: No PIN is set yet. Unknown values must be treated as
          this one.
        * ``PinTooShort``: The new PIN was too short.
        * ``PinTooLong``: The new PIN was too long.
        * ``PinPolicyViolation``: The new PIN does not meet the
          authenticator's PIN policy.
        * ``PinChangeRequired``: The authenticator requires the PIN to be
          changed.

        There are no supported keys in the @options vardict.
    -->
    <method name="NotifyPinNotSet">
      <arg type="o" name="session_handle" direction="in"/>
      <arg type="s" name="error" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In2" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
    </method>

    <!--
        NotifyNeedsUserVerification:
        @session_handle: Object path of the session
        @attempts_left: Number of built-in user verification attempts left, or ``0xffffffff`` if unknown
        @options: Vardict with optional further information

        The authenticator needs on-device user verification, such as a
        fingerprint. The backend should prompt the user to interact with the
        authenticator, and display @attempts_left before it falls back to PIN
        verification.

        There are no supported keys in the @options vardict.
    -->
    <method name="NotifyNeedsUserVerification">
      <arg type="o" name="session_handle" direction="in"/>
      <arg type="u" name="attempts_left" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In2" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
    </method>

    <!--
        NotifyNeedsUserPresence:
        @session_handle: Object path of the session
        @options: Vardict with optional further information

        The authenticator needs a user presence gesture, such as touching it.
        The backend should prompt the user to do so.

        There are no supported keys in the @options vardict.
    -->
    <method name="NotifyNeedsUserPresence">
      <arg type="o" name="session_handle" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In1" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
    </method>

    <!--
        NotifySelectingCredential:
        @session_handle: Object path of the session
        @credentials: Metadata for the credentials that match the request
        @options: Vardict with optional further information

        Multiple credentials match the request. The backend must let the user
        choose one, and send it with
        :ref:`org.freedesktop.impl.portal.experimental.Credential::CredentialSelected`.

        Each element of @credentials contains:

        * ``id`` (``s``)

          An opaque identifier for the credential in this ceremony. It is NOT
          the WebAuthn credential ID.

        * ``name`` (``s``)

          The account name of the credential.

        * ``username`` (``s``)

          The human-readable user name of the credential. Optional.

        There are no supported keys in the @options vardict.
    -->
    <method name="NotifySelectingCredential">
      <arg type="o" name="session_handle" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In1" value="QList&lt;QVariantMap&gt;"/>
      <arg type="aa{sv}" name="credentials" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In2" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
    </method>

    <!--
        NotifyHybridStarted:
        @session_handle: Object path of the session
        @invocation_data: File descriptor containing the data to show as a QR code
        @options: Vardict with optional further information

        Hybrid discovery started, and is waiting for the user to scan a QR
        code with their phone. The backend should display the data in
        @invocation_data as a QR code.

        @invocation_data contains UTF-8 text. The file must be memory-mapped
        to be read; call fstat() to determine the length of the data.

        There are no supported keys in the @options vardict.
    -->
    <method name="NotifyHybridStarted">
      <annotation name="org.gtk.GDBus.C.UnixFD" value="true"/>
      <arg type="o" name="session_handle" direction="in"/>
      <arg type="h" name="invocation_data" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In2" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
    </method>

    <!--
        NotifyHybridConnecting:
        @session_handle: Object path of the session
        @options: Vardict with optional further information

        The phone was detected, and a connection is being established. The
        backend should show a pending state, and ask the user to keep the
        devices close together.

        There are no supported keys in the @options vardict.
    -->
    <method name="NotifyHybridConnecting">
      <arg type="o" name="session_handle" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In1" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
    </method>

    <!--
        NotifyHybridConnected:
        @session_handle: Object path of the session
        @options: Vardict with optional further information

        The connection to the phone is established. The backend should ask the
        user to follow the instructions on their phone.

        There are no supported keys in the @options vardict.
    -->
    <method name="NotifyHybridConnected">
      <arg type="o" name="session_handle" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In1" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
    </method>

    <!--
        NotifyNfcConnected:
        @session_handle: Object path of the session
        @options: Vardict with optional further information

        An NFC authenticator was detected. The backend should ask the user to
        keep it on the reader until the ceremony completes.

        There are no supported keys in the @options vardict.
    -->
    <method name="NotifyNfcConnected">
      <arg type="o" name="session_handle" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In1" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
    </method>

    <!--
        NotifyUsbConnected:
        @session_handle: Object path of the session
        @options: Vardict with optional further information

        A USB authenticator is connected. The authenticator may need further
        user interaction, which is reported with the other ``Notify`` methods.

        There are no supported keys in the @options vardict.
    -->
    <method name="NotifyUsbConnected">
      <arg type="o" name="session_handle" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In1" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
    </method>

    <!--
        NotifyHybridRestarting:
        @session_handle: Object path of the session
        @options: Vardict with optional further information

        Hybrid discovery failed with a recoverable error, and is restarting.
        The ceremony continues.

        There are no supported keys in the @options vardict.
    -->
    <method name="NotifyHybridRestarting">
      <arg type="o" name="session_handle" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In1" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
    </method>

    <!--
        NotifyUsbRestarting:
        @session_handle: Object path of the session
        @options: Vardict with optional further information

        USB discovery failed with a recoverable error, and is restarting. The
        ceremony continues.

        There are no supported keys in the @options vardict.
    -->
    <method name="NotifyUsbRestarting">
      <arg type="o" name="session_handle" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In1" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
    </method>

    <!--
        NotifyNfcRestarting:
        @session_handle: Object path of the session
        @options: Vardict with optional further information

        NFC discovery failed with a recoverable error, and is restarting. The
        ceremony continues.

        There are no supported keys in the @options vardict.
    -->
    <method name="NotifyNfcRestarting">
      <arg type="o" name="session_handle" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In1" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
    </method>

    <!--
        NotifyCeremonyCompleted:
        @session_handle: Object path of the session

        The ceremony completed successfully. The backend should close the
        dialog and remove the session, without emitting
        :ref:`org.freedesktop.impl.portal.Session::Closed`.
    -->
    <method name="NotifyCeremonyCompleted">
      <arg type="o" name="session_handle" direction="in"/>
    </method>

    <!--
        NotifyErrorOccurred:
        @session_handle: Object path of the session
        @error: Error code

        The ceremony failed. The backend should show the error to the user.
        When the user dismisses it, the backend emits
        :ref:`org.freedesktop.impl.portal.Session::Closed` and removes the
        session.

        Supported values for @error:

        * ``0x80000001``: An internal error occurred.
        * ``0x80000002``: The request timed out.
        * ``0x80000003``: The request was cancelled.
        * ``0x80000004``: The authenticator reported an unknown error.
        * ``0x80000005``: The authenticator has no credentials matching the
          request.
        * ``0x80000006``: The authenticator already contains a credential
          excluded by the request.
        * ``0x80000007``: Too many incorrect PINs were entered, and the
          authenticator is locked.
        * ``0x80000008``: The authenticator has no PIN set.
    -->
    <method name="NotifyErrorOccurred">
      <arg type="o" name="session_handle" direction="in"/>
      <arg type="u" name="error" direction="in"/>
    </method>

    <!--
        DiscoveryRequested:
        @session_handle: Object path of the session
        @options: Vardict with optional further information

        Emitted when the dialog is ready, to ask the caller to start looking
        for authenticators.

        There are no supported keys in the @options vardict.
    -->
    <signal name="DiscoveryRequested">
      <arg type="o" name="session_handle"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out1" value="QVariantMap"/>
      <arg type="a{sv}" name="options"/>
    </signal>

    <!--
        ClientPinEntered:
        @session_handle: Object path of the session
        @pin_fd: File descriptor containing the PIN entered by the user
        @options: Vardict with optional further information

        Emitted after
        :ref:`org.freedesktop.impl.portal.experimental.Credential.NotifyNeedsPin`,
        when the user entered the PIN.

        @pin_fd is a ``memfd_secret`` file containing the UTF-8 PIN, at most
        63 bytes long. Its size is the length of the PIN.

        There are no supported keys in the @options vardict.
    -->
    <signal name="ClientPinEntered">
      <arg type="o" name="session_handle"/>
      <arg type="h" name="pin_fd"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out2" value="QVariantMap"/>
      <arg type="a{sv}" name="options"/>
    </signal>

    <!--
        SetDevicePin:
        @session_handle: Object path of the session
        @pin_fd: File descriptor containing the new PIN chosen by the user
        @options: Vardict with optional further information

        Emitted after
        :ref:`org.freedesktop.impl.portal.experimental.Credential.NotifyPinNotSet`,
        when the user chose a new PIN.

        @pin_fd is a ``memfd_secret`` file containing the UTF-8 PIN, at most
        63 bytes long. Its size is the length of the PIN.

        There are no supported keys in the @options vardict.
    -->
    <signal name="SetDevicePin">
      <arg type="o" name="session_handle"/>
      <arg type="h" name="pin_fd"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out2" value="QVariantMap"/>
      <arg type="a{sv}" name="options"/>
    </signal>

    <!--
        CredentialSelected:
        @session_handle: Object path of the session
        @id: The ``id`` of the selected credential
        @options: Vardict with optional further information

        Emitted after
        :ref:`org.freedesktop.impl.portal.experimental.Credential.NotifySelectingCredential`,
        when the user chose a credential.

        There are no supported keys in the @options vardict.
    -->
    <signal name="CredentialSelected">
      <arg type="o" name="session_handle"/>
      <arg type="s" name="id"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out2" value="QVariantMap"/>
      <arg type="a{sv}" name="options"/>
    </signal>

    <property name="version" type="u" access="read"/>
  </interface>
</node>
